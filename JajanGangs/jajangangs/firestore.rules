        allow delete: if cleanup();
      }
      match /event_notifications/{noticeId} {
        function parent() { return get(/databases/$(database)/documents/gangs/$(gangId)).data; }
        function cleanup() { return verified() && parent().ownerId == request.auth.uid && parent().state == 'DELETING'; }
        function invited() {
          let d = request.resource.data;
          return verified() && parent().state == 'ACTIVE' && request.auth.uid in parent().memberIds
            && !(noticeId in parent().memberIds) && parent().memberIds.size() < parent().capacity
            && d.keys().hasOnly(['type','gangId','recipientIds','inviterId','gangName','status','versionId','createdAt','readBy'])
            && d.type == 'gang_invite' && d.gangId == gangId && d.recipientIds == [noticeId]
            && d.inviterId == request.auth.uid && d.gangName == parent().name
            && d.status == 'REQUESTED' && d.versionId is string && d.versionId.size() <= 128
            && d.createdAt == request.time && d.readBy == {}
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(noticeId)).data.status == 'ACCEPTED'
            && socialAllowed(request.auth.uid, noticeId);
        }
        function message() {
          let d = request.resource.data;
          let m = getAfter(/databases/$(database)/documents/gangs/$(gangId)/messages/$(d.versionId)).data;
          return verified() && noticeId == 'message' && parent().state == 'ACTIVE' && request.auth.uid in parent().memberIds
            && d.keys().hasOnly(['type','gangId','recipientIds','versionId','createdAt','readBy'])
            && d.type == 'gang_message' && d.gangId == gangId
            && d.recipientIds == parent().memberIds.removeAll([request.auth.uid])
            && d.createdAt == request.time && d.readBy == {}
            && !exists(/databases/$(database)/documents/gangs/$(gangId)/messages/$(d.versionId))
            && m.senderId == request.auth.uid && m.createdAt == request.time;
        }
        function ack() {
          let d = request.resource.data;
          return verified() && request.auth.uid in resource.data.recipientIds
            && d.diff(resource.data).affectedKeys().hasOnly(['readBy'])
            && d.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid])
            && d.readBy[request.auth.uid] == resource.data.versionId;
        }
        function respond() {
          let d = request.resource.data;
          return owner(noticeId) && resource.data.type == 'gang_invite' && resource.data.status == 'REQUESTED'
            && d.diff(resource.data).affectedKeys().hasOnly(['status','readBy'])
            && d.readBy is map && d.readBy.keys().hasOnly([noticeId]) && d.readBy[noticeId] == resource.data.versionId
            && (d.status == 'REJECTED' || (d.status == 'ACCEPTED' && parent().state == 'ACTIVE'
              && noticeId in getAfter(/databases/$(database)/documents/gangs/$(gangId)).data.memberIds));
        }
        allow get: if verified() && (owner(noticeId) || request.auth.uid in parent().memberIds);
        allow list: if cleanup() && request.query.limit <= 100;
        allow create: if invited() || message();
        allow update: if ack() || respond() || message() || (resource.data.status in ['REJECTED','ACCEPTED'] && invited());
        allow delete: if cleanup();
      }
    }


    // Admin console: verified custom claims are issued only by a trusted Admin SDK.
    // These grants supplement existing client rules; ordinary app access is unchanged.
    function administrator() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.get('admin', false) == true;
    }
    function adminExpired(d) {
      return d.createdAt is timestamp && d.durationMinutes is int
        && request.time >= d.get('scheduledAt', d.createdAt) + duration.value(d.durationMinutes, 'm');
    }
    match /users/{uid} { allow read: if administrator(); }
    match /jajan_events/{eventId} {
      allow read: if administrator();
      allow update: if administrator() && adminExpired(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt'])
        && request.resource.data.state == 'CANCELLING' && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/admin_event_deletions/$(eventId));
      allow delete: if administrator() && adminExpired(resource.data) && resource.data.state == 'CANCELLING'
        && getAfter(/databases/$(database)/documents/admin_event_deletions/$(eventId)).data.status == 'DONE';
      match /{child}/{childId} {
        function knownChild() {
          return child in ['join_requests', 'messages', 'polls', 'wheels', 'wheel_history',
            'chat_state', 'chat_summary', 'event_notifications'];
        }
        function cleanupAuthorized() {
          return exists(/databases/$(database)/documents/admin_event_deletions/$(eventId))
            && ((!exists(/databases/$(database)/documents/jajan_events/$(eventId)))
              || (get(/databases/$(database)/documents/jajan_events/$(eventId)).data.state == 'CANCELLING'
                && adminExpired(get(/databases/$(database)/documents/jajan_events/$(eventId)).data)));
        }
        allow read: if administrator() && knownChild() && cleanupAuthorized();
        allow delete: if administrator() && knownChild() && cleanupAuthorized();
      }
    }
    match /active_jajan_slots/{uid} {
      allow get: if administrator();
      allow update: if administrator() && resource.data.eventId != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventId'])
        && request.resource.data.eventId == ''
        && !existsAfter(/databases/$(database)/documents/jajan_events/$(resource.data.eventId))
        && getAfter(/databases/$(database)/documents/admin_event_deletions/$(resource.data.eventId)).data.status == 'DONE'
        && getAfter(/databases/$(database)/documents/admin_event_deletions/$(resource.data.eventId)).data.creatorId == uid;
    }
    match /user_reports/{reportId} {
      allow read: if administrator();
      allow update: if administrator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewAuditId'])
        && request.resource.data.status in ['NEW', 'REVIEWING', 'RESOLVED', 'DISMISSED']
        && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
        && getAfter(/databases/$(database)/documents/admin_activity/$(request.resource.data.reviewAuditId)).data.targetId == reportId
        && getAfter(/databases/$(database)/documents/admin_activity/$(request.resource.data.reviewAuditId)).data.actorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/admin_activity/$(request.resource.data.reviewAuditId)).data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/admin_activity/$(request.resource.data.reviewAuditId)).data.action == 'REPORT_STATUS'
        && getAfter(/databases/$(database)/documents/admin_activity/$(request.resource.data.reviewAuditId)).data.status == request.resource.data.status;
    }
    match /admin_event_deletions/{eventId} {
      allow read: if administrator();
      allow create: if administrator()
        && request.resource.data.keys().hasOnly(['eventId', 'creatorId', 'originalState', 'eventCreatedAt', 'startedBy', 'startedAt', 'status'])
        && request.resource.data.eventId == eventId && request.resource.data.startedBy == request.auth.uid
        && request.resource.data.startedAt == request.time && request.resource.data.status == 'STARTED'
        && adminExpired(get(/databases/$(database)/documents/jajan_events/$(eventId)).data)
        && request.resource.data.creatorId == get(/databases/$(database)/documents/jajan_events/$(eventId)).data.creatorId
        && request.resource.data.originalState == get(/databases/$(database)/documents/jajan_events/$(eventId)).data.state
        && request.resource.data.eventCreatedAt == get(/databases/$(database)/documents/jajan_events/$(eventId)).data.createdAt
        && getAfter(/databases/$(database)/documents/jajan_events/$(eventId)).data.state == 'CANCELLING';
      allow update: if administrator() && resource.data.status == 'STARTED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedBy', 'completedAt'])
        && request.resource.data.status == 'DONE' && request.resource.data.completedBy == request.auth.uid
        && request.resource.data.completedAt == request.time
        && !existsAfter(/databases/$(database)/documents/jajan_events/$(eventId))
        && getAfter(/databases/$(database)/documents/admin_activity/$('delete_' + eventId)).data.actorId == request.auth.uid;
    }
    match /admin_activity/{auditId} {
      allow read: if administrator();
      allow create: if administrator() && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.action == 'DELETE_EXPIRED'
          && request.resource.data.keys().hasOnly(['actorId', 'action', 'targetId', 'createdAt'])
          && auditId == 'delete_' + request.resource.data.targetId
          && getAfter(/databases/$(database)/documents/admin_event_deletions/$(request.resource.data.targetId)).data.status == 'DONE'
          && getAfter(/databases/$(database)/documents/admin_event_deletions/$(request.resource.data.targetId)).data.completedBy == request.auth.uid)
        || (request.resource.data.action == 'REPORT_STATUS'
          && request.resource.data.keys().hasOnly(['actorId', 'action', 'targetId', 'previousStatus', 'status', 'createdAt'])
          && getAfter(/databases/$(database)/documents/user_reports/$(request.resource.data.targetId)).data.reviewAuditId == auditId
          && getAfter(/databases/$(database)/documents/user_reports/$(request.resource.data.targetId)).data.status == request.resource.data.status
          && get(/databases/$(database)/documents/user_reports/$(request.resource.data.targetId)).data.status == request.resource.data.previousStatus));
    }

    match /{document=**} { allow read, write: if false; }
  }
}
